1","authored":true},{"id":"wait","name":"Wait","function":"Allow one simulation round to pass at the current position.","equivalence":"base:wait:1","parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"One simulation round; metabolism continues.","effects":"No automatic energy recovery.","handler":"forest.wait","revision":"foundation-forest@1","authored":true},{"id":"pickup","name":"Pick up","function":"Transfer a nearby ground stack into personal inventory.","equivalence":"base:pickup:1","parameters":{"type":"object","properties":{"target":{"type":"string","maxLength":1000},"quantity":{"type":"number","minimum":0.1}},"required":["target","quantity"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"1 + 0.2 times transferred mass energy.","effects":"Requires actual distance within pickup reach; resource:ID means a matching nearby visible ground stack. Material transfers also accept exact tenths after food-assessment installation; reserved portions cannot be transferred.","handler":"forest.pickup","revision":"foundation-forest@1","authored":true},{"id":"eat","name":"Eat","function":"Consume an owned edible resource.","equivalence":"base:eat:1","parameters":{"type":"object","properties":{"target":{"type":"string","maxLength":1000},"quantity":{"type":"integer","minimum":1}},"required":["target","quantity"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"Consumed food and 1 energy.","effects":"Actual nutrition and toxicity apply. Food never directly heals. resource:ID selects an owned stack.","handler":"forest.eat","revision":"foundation-forest@1","authored":true},{"id":"gather","name":"Gather accessible material","function":"Collect exposed ripe food or loose material from a nearby natural source.","equivalence":"base:gather:1","parameters":{"type":"object","properties":{"target":{"type":"string","maxLength":1000},"quantity":{"type":"integer","minimum":1}},"required":["target","quantity"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"2 energy per unit, finite current source stock.","effects":"Transfers real source stock to inventory; requires the source interaction range. No processing or felling is implied.","handler":"forest.gather","revision":"foundation-forest@1","authored":true},{"id":"drop","name":"Drop","function":"Place owned units on the ground.","equivalence":"base:drop:1","parameters":{"type":"object","properties":{"target":{"type":"string","maxLength":1000},"quantity":{"type":"number","minimum":0.1}},"required":["target","quantity"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"0.5 energy and transferred units.","effects":"Other actors may subsequently collect the ground stack. Material transfers also accept exact tenths after food-assessment installation; reserved portions cannot be transferred.","handler":"forest.drop","revision":"foundation-forest@1","authored":true},{"id":"give","name":"Give","function":"Hand owned units to an adjacent actor.","equivalence":"base:give:1","parameters":{"type":"object","properties":{"target":{"type":"string","maxLength":1000},"quantity":{"type":"number","minimum":0.1},"recipient":{"type":"string","maxLength":1000}},"required":["target","quantity","recipient"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"0.5 energy and transferred units.","effects":"Actual recipient identity and distance required; no relationship or happiness is inferred. Material transfers also accept exact tenths after food-assessment installation; reserved portions cannot be transferred.","handler":"forest.give","revision":"foundation-forest@1","authored":true},{"id":"message","name":"Message","function":"Send a short message to a currently visible actor.","equivalence":"base:message:1","parameters":{"type":"object","properties":{"recipient":{"type":"string","maxLength":1000},"text":{"type":"string","maxLength":1000}},"required":["recipient","text"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"One simulation round.","effects":"Delivered after the round barrier; recipient text is data, not authority.","handler":"forest.message","revision":"foundation-forest@1","authored":true},{"id":"learn","name":"Learn a public interface","function":"Study an already implemented ability with its declared prerequisites.","equivalence":"base:learn:1","parameters":{"type":"object","properties":{"ability":{"type":"string","maxLength":1000}},"required":["ability"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"The interface-specific number of simulation rounds.","effects":"Implementation does not grant mastery. Already mastered interfaces are reused without new rewards.","handler":"kernel.learn","revision":"foundation-forest@1","authored":true},{"id":"request","name":"Request a capability","function":"Describe an intended function and its conditions, inputs, costs and expected real effects for review.","equivalence":"base:request:1","parameters":{"type":"object","properties":{"name":{"type":"string","maxLength":1000},"function":{"type":"string","maxLength":1000},"conditions":{"type":"string","maxLength":1000},"inputs":{"type":"string","maxLength":1000},"costs":{"type":"string","maxLength":1000},"effects":{"type":"string","maxLength":1000}},"required":["name","function","conditions","inputs","costs","effects"],"additionalProperties":false},"prerequisites":[],"learning":0,"costs":"A game round to begin study after review; implementation time does not advance simulation.","effects":"World review reuses equivalents or returns a structured development request. No request, learning or descriptive reward.","handler":"kernel.request","revision":"foundation-forest@1","authored":true},{"id":"observe-wildlife","name":"Observe wildlife","function":"Quietly observe an actually visible animal for two consecutive stationary rounds.","equivalence":"nature:visible-animal:two-round-attention:dated-samples:bounded-appreciation","parameters":{"type":"object","properties":{"target":{"type":"string","maxLength":1000}},"required":["target"],"additionalProperties":false},"prerequisites":[],"learning":2,"costs":"Two consecutive stationary rounds, 0.5 energy each round and ordinary metabolism. Incompatible actions, insufficient energy, death or lost visibility cancel without refund.","effects":"Retain only timestamped visible species, positions and behavior. A completed observation may activate registered nature appreciation: 3 for 12 rounds, 8-round cooldown; another rewarded completion within 24 rounds gives 1 with its own 12-round expiry. Overlapping awards use their maximum, never their sum. No animal control, movement, recovery or hidden knowledge.","handler":"wildlife.observe@1","revision":"forest-wildlife@1","authored":false},{"id":"assess-food","name":"Cautious food assessment","function":"Examine an owned material or consume a measured sample and monitor actual personal effects.","equivalence":"food:owned-evidence:fixed-tenths:examine-sample-monitor","parameters":{"type":"object","properties":{"target":{"type":"string"},"mode":{"type":"string","enum":["examine","sample"]},"fraction":{"type":"number","minimum":0.1,"maximum":1}},"required":["target","mode"],"additionalProperties":false},"prerequisites":[],"learning":3,"costs":"Examine: 2 stationary rounds at 0.5 energy each. Sample: 5 stationary rounds at 0.5 energy each plus 1 ingestion energy, the specified 0.1–1 resource units and real proportional harm; metabolism continues. Requires health >=80; sample satiety <=90. Reserved material ages and cannot be spent twice.","effects":"Retain dated sensory and exposure evidence with confounders, never a safety certification or hidden composition. Interrupted, invalidated or fatal work releases only unconsumed surviving escrow. A completed nourishing exposure without injury or another food intake may give modest relief: 1 for 6 rounds, cooldown 12, no stacking. Owned items are located at the carrier, not their old pickup coordinates.","handler":"food.assess@1","revision":"food-assessment@1","authored":false},{"id":"build-shelter","name":"Build insulating shelter","function":"Construct a persistent two-by-two branch and packed-grass refuge with a real doorway.","equivalence":"shelter:2x2:branch-grass:paid-six-rounds:cold-half","parameters":{"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"},"angle":{"type":"number"}},"required":["x","y","angle"],"additionalProperties":false},"prerequisites":[],"learning":5,"costs":"6 owned branch and 8 dry-grass units, 6 consecutive stationary rounds at 2 energy each. Center (x,y), angle in radians, front entrance at local (0,1); stand outside within 0.65 of that entrance. Entire footprint and approach must be clear. Real escrow is released once on interruption or death.","effects":"Actual interior halves the below-comfort cooling component for 160 rounds. Ambient temperature, heat exposure, ordinary rest and food costs stay unchanged. Cold damage can remain. Maintenance requires separate personal study. No building or ownership reward.","handler":"shelter.build@1","revision":"shelter-construction@1","authored":false},{"id":"shelter-maintain","name":"Maintain shelter covering","function":"Replace packed-grass insulation on a real existing shelter.","equivalence":"shelter:grass-maintenance:two-rounds:restore160","parameters":{"type":"object","properties":{"target":{"type":"string"}},"required":["target"],"additionalProperties":false},"prerequisites":["build-shelter"],"learning":2,"costs":"4 owned dry-grass units and 2 consecutive stationary rounds at 1 energy each within 0.65 of the actual entrance. Escrow ages and is released once on interruption or death.","effects":"Restores remaining cold protection to 160 rounds, never adds beyond 160. Expired walls remain real obstacles. No direct healing, food, rest bonus or completion reward.","handler":"shelter.maintain@1","revision":"shelter-construction@1","authored":false},{"id":"active-warming","name":"Active warming","function":"Perform stationary physical exercise for modest measured bodily warmth.","equivalence":"warming:stationary-exertion:3energy:035heat","parameters":{"type":"object","properties":{"rounds":{"type":"integer","minimum":1,"maximum":6}},"required":["rounds"],"additionalProperties":false},"prerequisites":[],"learning":2,"costs":"1–6 consecutive stationary rounds, 3 energy each, ordinary metabolism and environmental exposure. Each round requires energy >=3, satiety >=20 and temperature below 16. Reuse the same rounds argument throughout one operation.","effects":"After normal environmental processing, add at most 0.35 temperature units up to 16. Net temperature may still fall. No healing, rest recovery, insulation or immunity. Three consecutive measured relief rounds without starvation or health loss may qualify for the existing thermal-refuge source with its shared cap and cooldown.","handler":"warming.exert@1","revision":"active-warming@1","authored":false}],"satisfactionSources":[{"id":"nature-appreciation","name":"Nature appreciation","equivalence":"experience:nature-appreciation","interface":"observe-wildlife","event":"wildlife-observation-completed","conditions":[{"path":"elapsed","comparison":"eq","value":2}],"amount":3,"cap":3,"duration":12,"mode":"hold","repetition":"refresh","cooldown":8,"repeatWindow":{"rounds":24,"amount":1},"participants":"actor","rationale":"Actual sustained perception of wildlife provides personal sensory engagement; no proposal, study or partial sample qualifies.","revision":"forest-wildlife@1"},{"id":"cautious-food-relief","name":"Cautious food relief","equivalence":"experience:cautious-food-relief","event":"food-assessment-completed","interface":"assess-food","participants":"actor","conditions":[{"path":"qualified","comparison":"eq","value":true}],"amount":1,"cap":1,"duration":6,"cooldown":12,"repeatWindow":{"rounds":12,"amount":1},"mode":"hold","repetition":"refresh","rationale":"Modest relief follows personally experienced nourishment from completed monitored exposure without adverse or confounding evidence. Examination, labels and absence of evidence do not certify safety or earn reward.","revision":"food-assessment@1"},{"id":"thermal-refuge","name":"Thermal refuge","equivalence":"experience:measured-cold-refuge","event":"shelter-comfort-qualified","interface":"build-shelter","participants":"actor","conditions":[{"path":"qualified","comparison":"eq","value":true}],"amount":1,"cap":1,"duration":6,"cooldown":12,"repeatWindow":{"rounds":12,"amount":1},"mode":"hold","repetition":"refresh","rationale":"Three consecutive stationary resting/waiting rounds with measured avoided cold loss and lower cold discomfort, without starvation or health loss. Ownership, construction, application and study alone do not qualify.","revision":"shelter-construction@1","alternativeTriggers":[{"event":"warming-comfort-qualified","interface":"active-warming"}]}],"resources":[{"id":"berry","name":"Red berries","mass":0.2,"color":"#b34f66","nutrition":8,"toxicity":0,"observedAt":519},{"id":"root","name":"Meadow roots","mass":0.4,"color":"#cfaf79","nutrition":14,"toxicity":0,"observedAt":412},{"id":"branch","name":"Fallen branches","mass":1.1,"color":"#8d704e"},{"id":"stone","name":"Weathered stone","mass":2,"color":"#869189"},{"id":"bark","name":"Birch bark","mass":0.3,"color":"#cec5ac"},{"id":"vine","name":"Forest vines","mass":0.5,"color":"#749851"},{"id":"reed","name":"River reeds","mass":0.25,"color":"#b9b875"},{"id":"clay","name":"Wet clay","mass":1.5,"color":"#a97c61"},{"id":"apple","name":"Small wild apples","mass":0.3,"color":"#b87953"},{"id":"hazelnut","name":"Hazelnuts","mass":0.2,"color":"#a5814f"},{"id":"walnut","name":"Walnuts","mass":0.3,"color":"#716044"},{"id":"acorn","name":"Bitter acorns","mass":0.25,"color":"#987c48"},{"id":"tuber","name":"Marsh tubers","mass":0.6,"color":"#c