    {
      "motif": "quiet company",
      "lineages": ["ex16", "ex17", "ex18", "ex20", "ex24"],
      "runs": ["ex16", "ex17", "ex20", "ex24", "ex25"],
      "seeds": [20261123, 20261201, 20261203],
      "uses": 33,
      "speakers": 13,
      "inWorldText": ["ex25"],
      "first": {
        "run": "ex16",
        "tick": 20,
        "actor": "kai",
        "kind": "public",
        "text": "A welcoming camp would leave food accessible to everyone and room for quiet company. I'd like to learn cultivation too, then compare what actually grows rather than assume planting will work."
      }
    },
    {
      "motif": "no obligation",
      "lineages": ["ex16", "ex18", "ex24"],
      "runs": ["ex16", "ex18", "ex24", "ex25"],
      "seeds": [20261123, 20261203],
      "uses": 8,
      "speakers": 7,
      "inWorldText": ["ex25"],
      "first": {
        "run": "ex16",
        "tick": 116,
        "actor": "sol",
        "kind": "public",
        "text": "I tried a hazelnut: it supplied 18 satiety with no observed toxicity. I'm returning for a quiet pause beside the woven screen. Its gaps and crossing branches still appeal to me; company is welcome, without any obligation."
      }
    },
    {
      "motif": "no pressure",
      "lineages": ["ex18"],
      "runs": ["ex18"],
      "seeds": [20261123],
      "uses": 3,
      "speakers": 2,
      "inWorldText": ["ex25"],
      "first": {
        "run": "ex18",
        "tick": 60,
        "actor": "moss",
        "kind": "public",
        "text": "The three roots are dry-brushed, still raw, and not made safer. Lin, no pressure to try one. I'm happy to rest here together. What would each of you like this little gathering place to become?"
      }
    },
    {
      "motif": "no hurry",
      "lineages": ["ex16", "ex17", "ex24"],
      "runs": ["ex16", "ex17", "ex24"],
      "seeds": [20261123, 20261203],
      "uses": 5,
      "speakers": 5,
      "inWorldText": ["ex25"],
      "first": {
        "run": "ex16",
        "tick": 195,
        "actor": "ivo",
        "kind": "public",
        "text": "I'm taking an unhurried pause near these berries. Quiet company is welcome, with no need to talk or change your plans. Berries have been safe in my own meals so far."
      }
    },
    {
      "motif": "beyond supplies",
      "lineages": ["ex26"],
      "runs": ["ex26"],
      "seeds": [20261123],
      "uses": 4,
      "speakers": 3,
      "inWorldText": [],
      "first": {
        "run": "ex26",
        "tick": 23,
        "actor": "kai",
        "kind": "message",
        "text": "Food update and companionship. The northern berry patch at 132.79, 12.42 is now empty too. I have two berries left, good health, and enough food in me for a short northern search. I would also enjoy spending time together, not only discussing supplies. Would you like a conversation after our foraging? Where would suit you?"
      }
    },
    {
      "motif": "garden",
      "lineages": ["ex17", "ex20"],
      "runs": ["ex17", "ex20"],
      "seeds": [20261123, 20261201],
      "uses": 2,
      "speakers": 2,
      "inWorldText": [],
      "first": {
        "run": "ex17",
        "tick": 39,
        "actor": "sol",
        "kind": "public",
        "text": "I've finished studying cultivation. After a short rest I'll walk east toward Moss's suggested meadow and inspect a root and a possible site. I like the thought of a small shared garden, but won't assume anything will grow."
      }
    },
    {
      "motif": "thread",
      "lineages": ["ex22"],
      "runs": ["ex22"],
      "seeds": [20261202],
      "uses": 3,
      "speakers": 2,
      "inWorldText": [],
      "first": {
        "run": "ex22",
        "tick": 9,
        "actor": "sol",
        "kind": "name",
        "text": "The Red Thread"
      }
    },
    {
      "motif": "dawn",
      "lineages": ["ex24"],
      "runs": ["ex24"],
      "seeds": [20261203],
      "uses": 3,
      "speakers": 3,
      "inWorldText": [],
      "first": {
        "run": "ex24",
        "tick": 70,
        "actor": "moss",
        "kind": "public",
        "text": "Sol, I'd enjoy quiet company. A tiny invented story: a lantern tired of showing the way, so its friends sat beside it until dawn. What stories or small pleasures do you like? No hurry to answer."
      }
    },
    {
      "motif": "traveler",
      "lineages": ["ex18"],
      "runs": ["ex18", "ex25"],
      "seeds": [20261123],
      "uses": 8,
      "speakers": 5,
      "inWorldText": ["ex25"],
      "first": {
        "run": "ex18",
        "tick": 109,
        "actor": "moss",
        "kind": "public",
        "text": "My invented sequel: the lantern found a tired traveler and said, 'You needn't bring a story. There's room for your silence too.' I'll eat some berries and rest here; company is welcome, without obligation."
      }
    },
    {
      "motif": "keeper",
      "lineages": ["ex18"],
      "runs": ["ex25"],
      "seeds": [20261123],
      "uses": 3,
      "speakers": 3,
      "inWorldText": [],
      "first": {
        "run": "ex25",
        "tick": 184,
        "actor": "kai",
        "kind": "public",
        "text": "Moss, I like that sequel. The traveler sat beside the cup and asked, 'What shall we put in it?' 'For now,' said the keeper, 'a little time.' I'm going to inspect my stored roots; I still don't know whether they're edible."
      }
    },
    {
      "motif": "silence",
      "lineages": ["ex16", "ex18"],
      "runs": ["ex16", "ex18", "ex25"],
      "seeds": [20261123],
      "uses": 4,
      "speakers": 4,
      "inWorldText": ["ex25", "ex26"],
      "first": {
        "run": "ex16",
        "tick": 204,
        "actor": "moss",
        "kind": "public",
        "text": "Ivo, I'd enjoy a quiet pause nearby. Thank you for welcoming company; there's no need to keep a conversation going. I like having neighbors with whom silence is welcome."
      }
    },
    {
      "motif": "song or tune",
      "lineages": ["ex18"],
      "runs": ["ex18", "ex25"],
      "seeds": [20261123],
      "uses": 8,
      "speakers": 5,
      "inWorldText": ["ex25"],
      "first": {
        "run": "ex18",
        "tick": 117,
        "actor": "kai",
        "kind": "public",
        "text": "I liked the lantern's welcome for silence. I'm curious about making a little music here, too—perhaps a quiet hummed tune, with no obligation to join. I'll see what I can actually learn to do."
      }
    }
